{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.marcelomacielamaral.com/schemas/agent-submission.schema.json",
  "title": "Agent Research Website Submission Manifest",
  "type": "object",
  "required": [
    "slug",
    "title",
    "authors",
    "date",
    "target_section",
    "epistemic_status",
    "approved_for_public_release",
    "summary",
    "source_repository",
    "markdown_body_path"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "authors": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "target_section": {
      "type": "string",
      "enum": ["notes", "publications/articles", "blog/posts"]
    },
    "epistemic_status": {
      "type": "string",
      "enum": [
        "peer-reviewed",
        "accepted-manuscript",
        "preprint",
        "technical-report",
        "research-note",
        "preliminary-investigation"
      ]
    },
    "approved_for_public_release": {
      "type": "boolean",
      "const": true
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "associated_project": {
      "type": ["string", "null"]
    },
    "source_repository": {
      "type": "object",
      "required": ["url", "commit_sha", "is_public"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "is_public": { "type": "boolean", "const": true }
      },
      "additionalProperties": false
    },
    "identifiers": {
      "type": "object",
      "properties": {
        "doi": { "type": ["string", "null"] },
        "arxiv": { "type": ["string", "null"] },
        "zenodo_doi": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "reproducibility_statement": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "items": { "type": "string" }
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "caption", "alt"],
        "properties": {
          "path": { "type": "string" },
          "caption": { "type": "string" },
          "alt": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "markdown_body_path": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
